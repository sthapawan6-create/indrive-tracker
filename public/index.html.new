            <div style="background:white; padding:20px; border-radius:12px; border:1px solid var(--border-color);">
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-bottom:15px;">
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Purchase Date</label>
                        <input type="date" id="pur-date" onchange="updateBsDisplay('pur-date', 'pur-bs-date')" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:6px;">
                        <div id="pur-bs-date" style="font-size:0.75rem; color:#64748b; margin-top:4px;"></div>
                    </div>
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Supplier / Party</label>
                        <select id="pur-party-acc" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:6px;"><option value="">-- Select Supplier --</option></select>
                    </div>
                </div>
                <table id="pur-table">
                    <thead><tr><th>Item</th><th>Qty</th><th>Rate</th><th>Total</th></tr></thead>
                    <tbody id="pur-rows"></tbody>
                </table>
                <button class="btn" onclick="addPurRow()" style="margin-top:10px;">+ Add Item</button>
                <div style="text-align:right; margin-top:20px;">
                    <h4>Total: Rs. <span id="pur-grand-total">0.00</span></h4>
                    <button class="btn" onclick="savePurchase()">Save Purchase</button>
                </div>
            </div>
        </div>

        <div id="page-daybook" class="main-content">
            <div class="no-print" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3>Day Book (Dainik Khata)</h3>
                <div style="display:flex; gap:10px; align-items:center;">
                    <input type="text" id="daybook-search" oninput="renderDayBook()" placeholder="Search..." style="padding:8px; border-radius:6px; border:1px solid #ddd; width: 180px;">
                    <div style="display:flex; align-items:center; gap:5px; background:white; padding:5px 10px; border-radius:6px; border:1px solid #ddd;">
                        <span style="font-size:0.8rem; color:#64748b;">From:</span>
                        <input type="date" id="daybook-from" onchange="renderDayBook()" style="border:none; outline:none; font-size:0.85rem;">
                        <span style="font-size:0.8rem; color:#64748b; margin-left:5px;">To:</span>
                        <input type="date" id="daybook-to" onchange="renderDayBook()" style="border:none; outline:none; font-size:0.85rem;">
                    </div>
                    <button class="btn" onclick="window.print()" style="background:#1e293b;"><i class="fas fa-print"></i> Print</button>
                </div>
            </div>

            <div id="daybook-print-area" style="background:white; padding:20px; border-radius:12px; border:1px solid var(--border-color);">
                <div class="report-header only-print">
                    <h2 style="text-align:center; margin:0;">PAWAN ELECTRONICS</h2>
                    <p style="text-align:center; margin:5px 0;">Day Book Report</p>
                    <hr>
                </div>

                <table id="daybook-table">
                    <thead>
                        <tr style="background:#f1f5f9;">
                            <th style="padding:12px 10px;">Date</th>
                            <th style="padding:12px 10px;">Description / Account</th>
                            <th style="padding:12px 10px;">Type</th>
                            <th style="padding:12px 10px; text-align:right; color:#16a34a;">In (Receipt)</th>
                            <th style="padding:12px 10px; text-align:right; color:#dc2626;">Out (Payment)</th>
                            <th class="no-print" style="padding:12px 10px; text-align:center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="daybook-body"></tbody>
                    <tfoot>
                        <tr style="background:#f8fafc; font-weight:700; border-top:2px solid #e2e8f0;">
                            <td colspan="3" style="text-align:right; padding:12px;">Daily Totals:</td>
                            <td id="daybook-total-in" style="text-align:right; padding:12px; color:#16a34a;">0.00</td>
                            <td id="daybook-total-out" style="text-align:right; padding:12px; color:#dc2626;">0.00</td>
                            <td class="no-print"></td>
                        </tr>
                        <tr style="background:#f1f5f9; font-weight:800;">
                            <td colspan="3" style="text-align:right; padding:12px;">Net Cash Flow:</td>
                            <td colspan="2" id="daybook-net-balance" style="text-align:center; padding:12px; font-size:1.1rem;">0.00</td>
                            <td class="no-print"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

            </div>
        </div>
        <!-- Sales Book -->
        <div id="page-sales-book" class="main-content">
            <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
