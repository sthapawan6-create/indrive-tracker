                <div style="display:flex; gap:10px;">
                    <input type="text" id="sales-search" oninput="renderSalesBook()" placeholder="Search Bill / Party..." style="padding:5px; border-radius:4px; border:1px solid #ddd; width: 180px;">
                    <input type="date" id="sales-from" onchange="renderSalesBook()" style="padding:5px; border-radius:4px; border:1px solid #ddd;">
                    <input type="date" id="sales-to" onchange="renderSalesBook()" style="padding:5px; border-radius:4px; border:1px solid #ddd;">
                    <button class="btn" onclick="window.print()">Print Report</button>
                </div>
            </div>
            <table id="sales-book-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Bill No</th>
                        <th>Customer / PAN</th>
                        <th style="text-align:right;">Taxable</th>
                        <th style="text-align:right;">VAT (13%)</th>
                        <th style="text-align:right;">Total</th>
                        <th class="no-print">Actions</th>
                    </tr>
                </thead>
                <tbody id="sales-book-body"></tbody>
            </table>
        </div>

        <!-- Purchase Book -->
        <div id="page-purchase-book" class="main-content">
            <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                <h3>Purchase Book (Kharid Khata)</h3>
                <div style="display:flex; gap:10px;">
                    <input type="text" id="purchase-search" oninput="renderPurchaseBook()" placeholder="Search Bill / Party..." style="padding:5px; border-radius:4px; border:1px solid #ddd; width: 180px;">
                    <input type="date" id="purchase-from" onchange="renderPurchaseBook()" style="padding:5px; border-radius:4px; border:1px solid #ddd;">
                    <input type="date" id="purchase-to" onchange="renderPurchaseBook()" style="padding:5px; border-radius:4px; border:1px solid #ddd;">
                    <button class="btn" onclick="window.print()">Print Report</button>
                </div>
            </div>
            <table id="purchase-book-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Bill No</th>
                        <th>Supplier / PAN</th>
                        <th style="text-align:right;">Taxable</th>
                        <th style="text-align:right;">VAT (13%)</th>
                        <th style="text-align:right;">Total</th>
