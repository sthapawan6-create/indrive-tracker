        <!-- Ledger Statement Page -->
        <div id="page-statement" class="main-content">
            <div class="no-print" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3>Account Ledger Statement</h3>
                <button class="btn" onclick="window.print()" style="background:#1e293b;"><i class="fas fa-print"></i> Print PDF</button>
            </div>
            <div class="no-print" style="background:white; padding:15px; border-radius:8px; border:1px solid var(--border-color); margin-bottom:20px; display:flex; gap:15px; align-items:flex-end; flex-wrap: wrap;">
                <div style="flex:2; min-width: 250px; position:relative;">
                    <label style="font-size:0.8rem; color:#64748b;">Search & Select Account</label>
                    <input type="text" id="st-account-search" placeholder="Type account name..."
                        style="width:100%; padding:8px; border:1px solid #ddd; border-radius:6px; outline:none;"
                        oninput="filterLedgerAccounts(this.value)"
                        onfocus="document.getElementById('st-account-results').style.display='block'">
                    <div id="st-account-results" style="display:none; position:absolute; top:100%; left:0; width:100%; background:white; border:1px solid #ddd; border-radius:6px; z-index:100; max-height:200px; overflow-y:auto; box-shadow:0 4px 6px rgba(0,0,0,0.1);"></div>
                    <input type="hidden" id="st-account-id">

            </div>
        </div>
                <div style="flex:1; min-width: 120px;">
                    <label style="font-size:0.8rem; color:#64748b;">From</label>
                    <input type="date" id="st-from" onchange="renderStatement()" style="padding:7px; border:1px solid #ddd; border-radius:6px;">

            </div>
        </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">To</label>
                    <input type="date" id="st-to" onchange="renderStatement()" style="padding:7px; border:1px solid #ddd; border-radius:6px;">

            </div>
        </div>
                <button class="btn" onclick="printConfirmation()" style="background:#059669;"><i class="fas fa-certificate"></i> Confirmation</button>
            </div>
            <div id="statement-print-area" style="background:white; padding:30px; border-radius:12px; border:1px solid var(--border-color);">
                <div class="report-header">
                    <h2 style="margin:0;">PAWAN ELECTRONICS</h2>
                    <p style="margin:5px 0;">New Road, Kathmandu | Tel: 01-4XXXXXX</p>
                    <hr>

            </div>
        </div>

                <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                    <div>
                        <h4 style="margin:0;" id="st-display-name">Account Statement</h4>
                        <p style="margin:5px 0; color:#64748b; font-size:0.9rem;" id="st-display-type"></p>

            </div>
        </div>
                    <div style="text-align:right;">
                        <p style="margin:0; font-size:0.85rem;" id="st-display-date"></p>

            </div>
        </div>

            </div>
        </div>

                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Particulars / Description</th>
                            <th>Vch Type</th>
                            <th style="text-align:right;">Debit (Dr)</th>
                            <th style="text-align:right;">Credit (Cr)</th>
                            <th style="text-align:right;">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="st-tbody"></tbody>
                    <tfoot>
                        <tr style="background:#f8fafc; font-weight:bold;">
                            <td colspan="3" style="text-align:right;">Total</td>
                            <td id="st-total-dr" style="text-align:right;">0.00</td>
                            <td id="st-total-cr" style="text-align:right;">0.00</td>
                            <td id="st-final-bal" style="text-align:right;">0.00</td>
                        </tr>
                    </tfoot>
                </table>

            </div>
        </div>

            </div>
        </div>
        <div id="page-stock-summary" class="main-content">
            <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                <h3>Stock Summary</h3>
                <button class="btn" onclick="window.print()">Print Report</button>
            </div>
            <table id="stock-summary-table">
                <thead>
                    <tr><th>Item Name</th><th>Category</th><th style="text-align:right;">In Stock</th><th>Unit</th><th style="text-align:right;">Purchase Rate</th><th style="text-align:right;">Stock Value</th><th style="text-align:right;">Action</th></tr>
                </thead>
                <tbody id="stock-summary-body"></tbody>
                <tfoot>
                    <tr style="font-weight:bold; background:#f8fafc;">
                        <td colspan="5" style="text-align:right;">Total Inventory Value:</td>
                        <td id="total-stock-value" style="text-align:right;">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div id="page-users" class="main-content">
            <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
                <h3>User Management</h3>
                <button class="btn" onclick="openUserModal()">+ Add User</button>
            </div>
            <table id="users-table">
                <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody id="users-list-body"></tbody>
            </table>
        </div>

        <div id="page-settings" class="main-content">
            <h3>System Settings</h3>
            <div style="background:white; padding:25px; border-radius:12px; border:1px solid var(--border-color); max-width: 600px;">
                <h4 style="margin-top:0; border-bottom:1px solid #eee; padding-bottom:10px;"><i class="fas fa-building"></i> Company Profile</h4>
                <div style="display:grid; gap:15px; margin-top:15px;">
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Business / Shop Name</label>
                        <input type="text" id="set-comp-name" placeholder="e.g. Pawan Electronics" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                    </div>
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Address</label>
                        <input type="text" id="set-comp-addr" placeholder="e.g. New Road, Kathmandu" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                    </div>
                    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px;">
                        <div>
                            <label style="font-size:0.8rem; color:#64748b;">Phone Number</label>
                            <input type="text" id="set-comp-phone" placeholder="01-XXXXXX" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                        </div>
                        <div>
                            <label style="font-size:0.8rem; color:#64748b;">PAN / VAT Number</label>
                            <input type="text" id="set-comp-pan" placeholder="606XXXXXX" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                        </div>
                    </div>
                    <div style="margin-top:20px; border-top:1px solid #eee; padding-top:20px;">
                        <h4 style="margin-top:0;"><i class="fas fa-cloud-upload-alt"></i> Data Backup & Recovery</h4>
                        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px; margin-top:10px;">
                            <button class="btn" onclick="exportBackup()" style="background:#10b981;">
                                <i class="fas fa-download"></i> Export Local & Cloud Backup
                            </button>
                            <button class="btn" onclick="document.getElementById('import-file').click()" style="background:#6366f1;">
                                <i class="fas fa-upload"></i> Restore from Backup
                            </button>
                            <input type="file" id="import-file" style="display:none;" onchange="importBackup(event)">
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div>

    <!-- Product Modal -->
    <div id="product-modal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 id="product-modal-title">Add New Product</h3>
                <span onclick="closeProductModal()" style="cursor:pointer; font-size:1.5rem;">&times;</span>
            </div>
            <div style="display:grid; gap:15px;">
                <div style="display:grid; grid-template-columns: 1fr 2fr; gap:10px;">
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Code</label>
                        <input type="text" id="prod-code" readonly placeholder="Auto" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; background:#f8fafc;">
                    </div>
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Product Name</label>
                        <input type="text" id="prod-name" placeholder="e.g. Samsung A54" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                    </div>
                </div>
                <input type="text" id="prod-category" placeholder="Category (e.g. Mobile, TV)" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Sale Price</label>
                        <input type="number" id="prod-sale-price" placeholder="0.00" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                    </div>
                    <div>
                        <label style="font-size:0.8rem; color:#64748b;">Purchase Price</label>
                        <input type="number" id="prod-purchase-price" placeholder="0.00" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                    </div>
                </div>

            </div>
        </div>
                <input type="number" id="prod-stock" placeholder="Opening Stock" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                <button class="btn" onclick="saveProduct()">Save Product</button>
            </div>
        </div>
    </div>

    <!-- Account Modal -->
    <div id="account-modal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 id="modal-title">Add New Account</h3>
                <span onclick="closeAccountModal()" style="cursor:pointer; font-size:1.5rem;">&times;</span>
            </div>
            <div style="display:grid; gap:15px;">
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Account Name</label>
                    <input type="text" id="acc-name" placeholder="e.g. Ram Prasad / Petrol Expense" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Account Type (Group)</label>
                    <select id="acc-type" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                        <option value="Receivable">Customer (Receivable)</option>
                        <option value="Payable">Supplier (Payable)</option>
                        <option value="Expense">Expense (खर्च)</option>
                        <option value="Asset">Bank/Cash (Asset)</option>
                        <option value="Revenue">Income (Revenue)</option>
                        <option value="Equity">Equity/Capital (पुँजी)</option>
                    </select>
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Opening Balance (Optional)</label>
                    <input type="number" id="acc-balance" value="0" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">PAN / VAT Number</label>
                    <input type="text" id="acc-pan" placeholder="9-digit PAN" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div style="display:flex; gap:10px; margin-top:10px;">
                    <button class="btn" onclick="saveAccount()" style="flex:1;">Save Account</button>
                    <button class="btn" onclick="closeAccountModal()" style="background:#64748b; flex:1;">Cancel</button>
                </div>
            </div>
        </div>
    </div>


    <!-- User Modal -->
    <div id="user-modal" class="modal">
        <div class="modal-content">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                <h3 id="user-modal-title">Add New User</h3>
                <span onclick="closeUserModal()" style="cursor:pointer; font-size:1.5rem;">&times;</span>
            </div>
            <div style="display:grid; gap:15px;">
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Full Name</label>
                    <input type="text" id="user-fullname" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Email</label>
                    <input type="email" id="user-email" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Password</label>
                    <input type="password" id="user-password" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                </div>
                <div>
                    <label style="font-size:0.8rem; color:#64748b;">Role</label>
                    <select id="user-role" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px; margin-top:5px;">
                        <option value="Admin">Admin</option>
                        <option value="Manager">Manager</option>
                        <option value="Staff">Staff</option>
                    </select>
                </div>
                <div style="display:flex; gap:10px; margin-top:10px;">
                    <button class="btn" onclick="saveUser()" style="flex:1;">Save User</button>
                    <button class="btn" onclick="closeUserModal()" style="background:#64748b; flex:1;">Cancel</button>
                </div>
            </div>
        </div>
    </div>


    <script>
        // --- Global State & Auth ---
        let currentUser = JSON.parse(localStorage.getItem('pawanelex_user'));
        if (!currentUser) window.location.href = 'login.html';

        // Role-Based Access Control (RBAC) UI enforcement
        document.addEventListener('DOMContentLoaded', () => {
            if (currentUser && currentUser.role !== 'Admin') {
                // Hide restricted menu items
                const restrictedItems = ['users', 'settings'];
                document.querySelectorAll('.menu-item').forEach(item => {
                    const onclickStr = item.getAttribute('onclick') || '';
                    if (restrictedItems.some(r => onclickStr.includes(`'${r}'`))) {
                        item.style.display = 'none';
                    }
                });

                // Also hide Master section titles if everything inside is hidden
                // For Manager/Staff, they can see Items/Accounts so we keep it.
            }
        });

        const API_URL = window.location.origin + '/api';
        let accounts = [];
        let products = [];
        let transactions = [];
        let users = [];
        let dashboardChart = null;

        // Helper to handle both string IDs and Mongoose objects
        function getAccountId(acc) {
            if (!acc) return null;
            return typeof acc === 'object' ? (acc._id || acc.id) : acc;
        }

        // --- Date Helpers (AD/BS) ---
        function adToBs(adDateStr) {
            try {
                if (!adDateStr) return "-";
                // Standard Date object from input string
                const adDate = new Date(adDateStr);
                if (isNaN(adDate.getTime())) return adDateStr;

                // NepaliDate library (from CDN) works well with Date objects
                // We use window.NepaliDate as it is loaded via script tag
                const NepaliDateLib = window.NepaliDate;

                if (typeof NepaliDateLib === 'function') {
                    const bsDate = new NepaliDateLib(adDate);
                    // Return formatted string YYYY-MM-DD
                    return bsDate.format('YYYY-MM-DD');
                } else {
                    console.warn("NepaliDate library not available");
                    return adDateStr;
                }
            } catch (e) {
                console.error("Date conversion failed:", e);
                return adDateStr;
            }
        }

        function formatDate(adDateStr) {
            const bs = adToBs(adDateStr);
            return `<div style="font-size:0.9rem;">${adDateStr}</div><div style="font-size:0.7rem; color:#64748b;">${bs} BS</div>`;
        }

        function updateBsDisplay(inputId, displayId) {
            const ad = document.getElementById(inputId).value;
            document.getElementById(displayId).innerText = ad ? adToBs(ad) + " BS" : "";
        }

        // Helper to get total amount from any transaction type
        function getTxAmount(tx) {
            if (tx.totalAmount && tx.totalAmount > 0) return tx.totalAmount;
            if (tx.entries && tx.entries.length > 0) {
                // Sum all debits (which is the total transaction value)
                return tx.entries.reduce((sum, e) => sum + (e.debit || 0), 0);
            }
            return 0;
        }

        // --- Core Navigation ---
        window.showPage = function(pageId) {
            console.log("Navigating to:", pageId);
            document.querySelectorAll('.main-content').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.menu-item').forEach(m => m.classList.remove('active'));

            const target = document.getElementById('page-' + pageId);
            if(target) {
                target.classList.add('active');
            } else {
                document.getElementById('page-gateway').classList.add('active');
                pageId = 'gateway';
            }

            const menuItems = document.querySelectorAll('.menu-item');
            menuItems.forEach(item => {
                if(item.getAttribute('onclick') && item.getAttribute('onclick').includes(pageId)) {
                    item.classList.add('active');
                }
            });

            refreshData(pageId);
        };

        async function refreshData(pageId) {
            try {
                // Pull all data from API to ensure we have the latest "old data"
                await Promise.all([loadAccounts(), loadProducts(), loadTransactions()]);

                if(pageId === 'gateway') {
                    renderDashboard();
                    renderChart();
                }
                if(pageId === 'accounts') renderAccountsList();
                if(pageId === 'products') renderProductsList();
                if(pageId === 'billing') initBillingForm();
                if(pageId === 'purchase') initPurchaseForm();
                if(pageId === 'journal') initJournalForm();
                if(pageId === 'daybook') renderDayBook();
                if(pageId === 'statement') initStatementPage();
                if(pageId === 'sales-book') renderSalesBook();
                if(pageId === 'purchase-book') renderPurchaseBook();
                if(pageId === 'stock-summary') renderStockSummary();
                if(pageId === 'trial-balance') renderTrialBalance();
                if(pageId === 'profit-loss') renderProfitLoss();
                if(pageId === 'balance-sheet') renderBalanceSheet();
                if(pageId === 'vat-report') renderVatReport();
                if(pageId === 'payment-book') renderPaymentBook();
                if(pageId === 'users') loadUsers();
                if(pageId === 'settings') initSettings();
            } catch (err) {
                console.error("Data Load Error:", err);
            }
        }

        // --- API Calls ---
        async function loadAccounts() {
            const res = await fetch(`${API_URL}/accounts?userId=${currentUser.uid}`);
            accounts = await res.json();
            localStorage.setItem('pawan_accounts', JSON.stringify(accounts));
        }

        async function loadProducts() {
            const res = await fetch(`${API_URL}/products?userId=${currentUser.uid}`);
            products = await res.json();
        }

        async function loadTransactions() {
            const res = await fetch(`${API_URL}/transactions?userId=${currentUser.uid}`);
            transactions = await res.json();
            localStorage.setItem('pawan_transactions', JSON.stringify(transactions));
        }

        // --- User Management Logic ---
        async function loadUsers() {
            if (currentUser.role !== 'Admin') {
                alert("Access Denied: Admin only.");
                showPage('gateway');
                return;
            }
            const res = await fetch(`${API_URL}/users`);
            users = await res.json();
            renderUsersList();
        }

        function updateInvRowPrice(el) {
            const row = el.closest('tr');
            const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
            const rate = parseFloat(row.querySelector('.row-rate').value) || 0;
            row.querySelector('.row-total').value = (qty * rate).toFixed(2);
            calcInvTotal();
        }

        function calcInvTotal() {
            let total = 0;
            document.querySelectorAll('#inv-rows .row-total').forEach(el => {
                total += parseFloat(el.value) || 0;
            });
            document.getElementById('inv-grand-total').innerText = total.toFixed(2);
        }

        function updatePurRowPrice(el) {
            const row = el.closest('tr');
            const qty = parseFloat(row.querySelector('.row-qty').value) || 0;
            const rate = parseFloat(row.querySelector('.row-rate').value) || 0;
            row.querySelector('.row-total').value = (qty * rate).toFixed(2);
            calcPurTotal();
        }

        function calcPurTotal() {
            let total = 0;
            document.querySelectorAll('#pur-rows .row-total').forEach(el => {
                total += parseFloat(el.value) || 0;
            });
            document.getElementById('pur-grand-total').innerText = total.toFixed(2);
        }

        async function editTransaction(id) {
            const tx = transactions.find(t => t._id === id);
            if (!tx) return;

            if (tx.type === 'SALES') {
                showPage('billing');
                document.getElementById('inv-date').value = tx.date;
                document.getElementById('inv-party-acc').value = tx.entries[0].account._id || tx.entries[0].account;
                const tbody = document.getElementById('inv-rows');
                tbody.innerHTML = '';
                (tx.items || []).forEach(item => addInvRow(item));
                calcInvTotal();
            } else if (tx.type === 'PURCHASE') {
                showPage('purchase');
                document.getElementById('pur-date').value = tx.date;
                document.getElementById('pur-party-acc').value = tx.entries[0].account._id || tx.entries[0].account;
                const tbody = document.getElementById('pur-rows');
                tbody.innerHTML = '';
                (tx.items || []).forEach(item => addPurRow(item));
                calcPurTotal();
            } else if (tx.type === 'JOURNAL') {
                showPage('journal');
                document.getElementById('jr-date').value = tx.date;
                document.getElementById('jr-desc').value = tx.description;
                const tbody = document.getElementById('jr-rows');
                tbody.innerHTML = '';
                tx.entries.forEach(e => addJournalRow(e));
                calcJournal();
            }
        }

        let editingUserId = null;
        function openUserModal() {
            editingUserId = null;
            document.getElementById('user-modal-title').innerText = 'Add New User';
            document.getElementById('user-fullname').value = '';
            document.getElementById('user-email').value = '';
            document.getElementById('user-password').value = '';
            document.getElementById('user-role').value = 'Staff';
            document.getElementById('user-modal').style.display = 'block';
        }

        function closeUserModal() {
            document.getElementById('user-modal').style.display = 'none';
        }

        function editUser(id) {
            const user = users.find(u => u._id === id);
            if (!user) return;
            editingUserId = id;
            document.getElementById('user-modal-title').innerText = 'Edit User';
            document.getElementById('user-fullname').value = user.fullname;
            document.getElementById('user-email').value = user.email;
            document.getElementById('user-password').value = ''; // Keep empty for no change
            document.getElementById('user-role').value = user.role;
            document.getElementById('user-modal').style.display = 'block';
        }

        async function saveUser() {
            const fullname = document.getElementById('user-fullname').value;
            const email = document.getElementById('user-email').value;
            const password = document.getElementById('user-password').value;
            const role = document.getElementById('user-role').value;

            if (!fullname || !email) return alert("Name and Email required");
            if (!editingUserId && !password) return alert("Password required for new user");

            const userData = { fullname, email, role };
            if (password) userData.password = password;

            const url = editingUserId ? `${API_URL}/users/${editingUserId}` : `${API_URL}/users`;
            const method = editingUserId ? 'PUT' : 'POST';

            const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(userData)
            });

            if (res.ok) {
                alert("User Saved!");
                closeUserModal();
                loadUsers();
            } else {
                const err = await res.json();
                alert(err.error || "Error saving user");
            }
        }

        async function deleteUser(id) {
            if (id === currentUser.uid) return alert("Cannot delete yourself!");
            if (!confirm("Delete this user?")) return;
            const res = await fetch(`${API_URL}/users/${id}`, { method: 'DELETE' });
            if (res.ok) {
                alert("User deleted");
                loadUsers();
            }
        }

        window.openDashDetail = function(type) {
            const modal = document.getElementById('dash-detail-modal');
            const title = document.getElementById('dash-detail-title');
            const body = document.getElementById('dash-detail-body');
            modal.style.display = 'block';

            let html = `<table><thead><tr><th>Particulars</th><th style="text-align:right;">Amount</th></tr></thead><tbody>`;
            let total = 0;
            const todayStr = new Date().toISOString().split('T')[0];

            if (type === 'cash') {
                title.innerText = 'Cash & Bank Balances';
                accounts.filter(a => a.type === 'Asset').forEach(acc => {
                    html += `<tr><td>${acc.name}</td><td style="text-align:right;">Rs. ${(acc.balance || 0).toLocaleString()}</td></tr>`;
                    total += (acc.balance || 0);
                });
            } else if (type === 'income') {
                title.innerText = "Today's Income Breakdown (" + todayStr + ")";
                const incomeAccs = {};
                transactions.filter(tx => tx.date === todayStr).forEach(tx => {
                    tx.entries.forEach(e => {
                        const acc = accounts.find(a => a._id === getAccountId(e.account));
                        if (acc && acc.type === 'Revenue') {
                            incomeAccs[acc.name] = (incomeAccs[acc.name] || 0) + (e.credit || 0);
                        }
                    });
                });
                Object.keys(incomeAccs).forEach(name => {
                    html += `<tr><td>${name}</td><td style="text-align:right;">Rs. ${incomeAccs[name].toLocaleString()}</td></tr>`;
                    total += incomeAccs[name];
                });
            } else if (type === 'expense') {
                title.innerText = "Today's Expenses (" + todayStr + ")";
                const expenseAccs = {};
                transactions.filter(tx => tx.date === todayStr).forEach(tx => {
                    tx.entries.forEach(e => {
                        const acc = accounts.find(a => a._id === getAccountId(e.account));
                        if (acc && acc.type === 'Expense') {
                            expenseAccs[acc.name] = (expenseAccs[acc.name] || 0) + (e.debit || 0);
                        }
                    });
                });
                Object.keys(expenseAccs).forEach(name => {
                    html += `<tr><td>${name}</td><td style="text-align:right;">Rs. ${expenseAccs[name].toLocaleString()}</td></tr>`;
                    total += expenseAccs[name];
                });
            } else if (type === 'receivable') {
                title.innerText = 'Receivables (Linu Parne)';
                accounts.filter(a => a.type === 'Receivable' && (a.balance || 0) > 0).forEach(acc => {
                    html += `<tr onclick="viewLedger('${acc._id}')" style="cursor:pointer; transition:0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                        <td>${acc.name}</td>
                        <td style="text-align:right;">Rs. ${(acc.balance || 0).toLocaleString()}</td>
                    </tr>`;
                    total += (acc.balance || 0);
                });
            } else if (type === 'payable') {
                title.innerText = 'Payables (Tirnu Parne)';
                accounts.filter(a => a.type === 'Payable' && (a.balance || 0) > 0).forEach(acc => {
                    html += `<tr onclick="viewLedger('${acc._id}')" style="cursor:pointer; transition:0.2s;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='transparent'">
                        <td>${acc.name}</td>
                        <td style="text-align:right;">Rs. ${(acc.balance || 0).toLocaleString()}</td>
                    </tr>`;
                    total += (acc.balance || 0);
                });
            } else if (type === 'purchase') {
                title.innerText = "Today's Purchases (" + todayStr + ")";
                transactions.filter(tx => tx.date === todayStr && tx.type === 'PURCHASE').forEach(tx => {
                    html += `<tr><td>${tx.description}</td><td style="text-align:right;">Rs. ${tx.totalAmount.toLocaleString()}</td></tr>`;
                    total += tx.totalAmount;
                });
            }

            if (total === 0) html += `<tr><td colspan="2" style="text-align:center; padding:20px; color:#64748b;">No records found for today.</td></tr>`;

            html += `</tbody><tfoot><tr style="font-weight:bold; background:#f8fafc;"><td>Total</td><td style="text-align:right;">Rs. ${total.toLocaleString()}</td></tr></tfoot></table>`;
            body.innerHTML = html;
        };

        window.closeDashDetailModal = function() {
            document.getElementById('dash-detail-modal').style.display = 'none';
        };

        window.viewLedger = function(accountId) {
            closeDashDetailModal();
            // Store selected account in localStorage for the statement page to pick up
            localStorage.setItem('selected_ledger_account', accountId);
            showPage('statement');
        };

        // --- Rendering Logic ---
        function printInvoice(txId) {
            const tx = transactions.find(t => t._id === txId);
            if (!tx) return;

            const party = accounts.find(a => a._id === getAccountId(tx.entries[0].account));
            const settings = JSON.parse(localStorage.getItem('erp_settings')) || { name: "PAWAN ELECTRONICS", address: "New Road", phone: "01-XXXX" };

            const printWin = window.open('', '', 'width=400,height=600');
            let itemRows = (tx.items || []).map(item => {
                const p = products.find(prod => prod._id === item.product);
                return `
                    <tr>
                        <td colspan="2" style="padding-top:5px; font-weight:bold;">${p ? p.name : 'Item'}</td>
                    </tr>
                    <tr style="border-bottom: 1px dotted #ccc;">
                        <td style="text-align:left;">${item.quantity} x ${item.rate.toFixed(2)}</td>
                        <td style="text-align:right;">${(item.quantity * item.rate).toFixed(2)}</td>
                    </tr>`;
            }).join('');

            const total = tx.totalAmount;
            const taxable = total / 1.13;
            const vat = total - taxable;

            printWin.document.write(`
                <html>
                <head>
                    <title>Invoice #${txId.slice(-6)}</title>
                    <style>
                        @page { margin: 0; }
                        body {
                            font-family: 'Courier New', Courier, monospace;
                            width: 72mm;
                            margin: 0;
                            padding: 5mm;
                            font-size: 11px;
                            line-height: 1.2;
                            color: #000;
                        }
                        .header { text-align: center; margin-bottom: 10px; }
                        .divider { border-top: 1px dashed #000; margin: 5px 0; }
                        table { width: 100%; border-collapse: collapse; }
                        .total-section { margin-top: 5px; }
                        .bold { font-weight: bold; }
                        .text-center { text-align: center; }
                    </style>
                </head>
                <body>
                    <div class="header">
                        <div style="font-size: 14px; font-weight: bold;">${settings.name}</div>
                        <div>${settings.address}</div>
                        <div>Tel: ${settings.phone}</div>
                        <div class="bold" style="margin-top:5px; text-decoration: underline;">TAX INVOICE</div>

            </div>
        </div>
                    <div style="margin-bottom: 5px;">
                        Party: ${party ? party.name : 'Cash Customer'}<br>
                        PAN/VAT: ${party?.panVat || '-'}<br>
                        Bill: #${txId.slice(-6).toUpperCase()} | ${tx.date}

            </div>
        </div>
                    <div class="divider"></div>
                    <table>
                        <thead>
                            <tr style="border-bottom: 1px solid #000;">
                                <th style="text-align:left;">Description</th>
                                <th style="text-align:right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>${itemRows}</tbody>
                    </table>
                    <div class="total-section">
                        <div style="display:flex; justify-content:space-between;">
                            <span>Taxable:</span><span>${taxable.toFixed(2)}</span>

            </div>
        </div>
                        <div style="display:flex; justify-content:space-between;">
                            <span>VAT (13%):</span><span>${vat.toFixed(2)}</span>

            </div>
        </div>
                        <div class="divider"></div>
                        <div style="display:flex; justify-content:space-between; font-size: 13px;" class="bold">
                            <span>NET TOTAL:</span><span>Rs. ${total.toFixed(2)}</span>

            </div>
        </div>

            </div>
        </div>
                    <div class="divider"></div>
                    <div class="text-center" style="margin-top:10px; font-size: 10px;">
                        Thank You! Please visit again.

            </div>
        </div>
                    <script>window.onload = function() { window.print(); setTimeout(() => window.close(), 500); }<\/script>
                </body>
                </html>
            `);
            printWin.document.close();
        }

        function renderDashboard() {
            const settings = JSON.parse(localStorage.getItem('erp_settings')) || { name: "PAWAN ELECTRONICS" };
            document.querySelector('.logo h2').innerText = settings.name;

            // Low Stock Alert
            const lowStock = products.filter(p => (p.currentStock || 0) < 5);
            const dashboard = document.getElementById('page-gateway');
            const existingAlert = dashboard.querySelector('.stock-alert');
            if(existingAlert) existingAlert.remove();

            if(lowStock.length > 0) {
                const alertDiv = document.createElement('div');
                alertDiv.className = 'stock-alert';
                alertDiv.style.background = '#fee2e2'; alertDiv.style.color = '#991b1b';
                alertDiv.style.padding = '12px 20px'; alertDiv.style.borderRadius = '10px';
                alertDiv.style.marginBottom = '20px'; alertDiv.style.border = '1px solid #fecaca';
                alertDiv.style.display = 'flex'; alertDiv.style.alignItems = 'center'; alertDiv.style.gap = '10px';
                alertDiv.innerHTML = `<i class="fas fa-exclamation-triangle"></i> <div><strong>Low Stock:</strong> ${lowStock.slice(0,3).map(p => p.name).join(', ')}${lowStock.length > 3 ? '...' : ''}</div>`;
                dashboard.insertBefore(alertDiv, dashboard.querySelector('.dashboard-grid'));
            }

            let cashBank = 0, rec = 0, pay = 0, income = 0, expense = 0;
            let overallExpense = 0;
            let todaySales = 0, yesterdaySales = 0;

            const todayStr = new Date().toISOString().split('T')[0];
            const yesterday = new Date(); yesterday.setDate(yesterday.getDate() - 1);
            const yesterdayStr = yesterday.toISOString().split('T')[0];

            accounts.forEach(acc => {
                const bal = acc.balance || 0;
                if (acc.type === 'Asset') cashBank += bal;
                if (acc.type === 'Receivable') rec += bal;
                if (acc.type === 'Payable') pay += bal;
                if (acc.type === 'Expense') overallExpense += Math.abs(bal);
            });

            transactions.forEach(tx => {
                if (tx.date === todayStr) {
                    if (tx.type === 'SALES') todaySales += tx.totalAmount;
                }
                if (tx.date === yesterdayStr) {
                    if (tx.type === 'SALES') yesterdaySales += tx.totalAmount;
                }

                // Today's P&L items
                if (tx.date === todayStr) {
                    tx.entries.forEach(e => {
                        const acc = accounts.find(a => a._id === getAccountId(e.account));
                        if (acc) {
                            if (acc.type === 'Revenue') income += (e.credit || 0);
                            if (acc.type === 'Expense') expense += (e.debit || 0);
                        }
                    });
                }
            });

            // Stock and Profit
            let stockVal = 0;
            products.forEach(p => stockVal += (p.currentStock || 0) * (p.purchasePrice || 0));
            const netProfit = calculateNetProfit();

            // Growth Calculation
            const growth = yesterdaySales === 0 ? (todaySales > 0 ? 100 : 0) : ((todaySales - yesterdaySales) / yesterdaySales * 100);
            const growthEl = document.getElementById('dash-growth-val');
            growthEl.innerText = `${Math.abs(growth).toFixed(1)}%`;
            document.getElementById('dash-growth-icon').innerHTML = growth >= 0 ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>';

            // Net Margin
            let totalRevenue = 0;
            accounts.filter(a => a.type === 'Revenue').forEach(a => totalRevenue += Math.abs(a.balance || 0));
            const margin = totalRevenue === 0 ? 0 : (netProfit / totalRevenue * 100);
            document.getElementById('dash-margin-val').innerText = `${margin.toFixed(1)}%`;

            // Expense Ratio
            const expRatio = totalRevenue === 0 ? 0 : (overallExpense / totalRevenue * 100);
            document.getElementById('dash-exp-ratio').innerText = `${expRatio.toFixed(1)}%`;

            // Calculate Today vs Yesterday Expenses
            let yesterdayExp = 0;
            transactions.filter(tx => tx.date === yesterdayStr).forEach(tx => {
                tx.entries.forEach(e => {
                    const acc = accounts.find(a => a._id === getAccountId(e.account));
                    if (acc && acc.type === 'Expense') yesterdayExp += (e.debit || 0);
                });
            });

            const expTrend = yesterdayExp === 0 ? (expense > 0 ? 100 : 0) : ((expense - yesterdayExp) / yesterdayExp * 100);
            const expTrendEl = document.getElementById('dash-exp-trend');
            expTrendEl.innerText = `${expTrend >= 0 ? '+' : ''}${expTrend.toFixed(1)}%`;
            expTrendEl.style.color = expTrend > 0 ? '#dc2626' : '#16a34a';

            document.getElementById('dash-sales-trend').innerText = `${growth >= 0 ? '+' : ''}${growth.toFixed(1)}%`;
            document.getElementById('dash-sales-trend').style.color = growth >= 0 ? '#16a34a' : '#dc2626';

            const todayNet = income - expense;
            const todayNetEl = document.getElementById('dash-today-net');
            todayNetEl.innerText = `Rs. ${todayNet.toLocaleString('en-IN')}`;
            todayNetEl.style.color = todayNet >= 0 ? '#16a34a' : '#dc2626';

            // Top Expenses Breakdown
            const expenseAccs = accounts.filter(a => a.type === 'Expense')
                .sort((a, b) => Math.abs(b.balance || 0) - Math.abs(a.balance || 0))
                .slice(0, 5);

            const topExpContainer = document.getElementById('dash-top-expenses');
            if (expenseAccs.length > 0) {
                const maxExp = Math.abs(expenseAccs[0].balance || 1);
                topExpContainer.innerHTML = expenseAccs.map(acc => {
                    const bal = Math.abs(acc.balance || 0);
                    const pc = (bal / maxExp * 100);
                    return `
                        <div>
                            <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:4px;">
                                <span style="font-weight:600; color:#475569;">${acc.name}</span>
                                <span style="font-weight:700; color:#1e293b;">Rs. ${bal.toLocaleString('en-IN')}</span>

            </div>
        </div>
                            <div style="height:6px; background:#f1f5f9; border-radius:10px; overflow:hidden;">
                                <div style="height:100%; background:#6366f1; width:${pc}%; border-radius:10px;"></div>

            </div>
        </div>

            </div>
        </div>
                    `;
                }).join('');
            } else {
                topExpContainer.innerHTML = `<p style="text-align:center; color:#94a3b8; font-size:0.85rem;">No expenses recorded yet.</p>`;
            }

            // Update Cards
            document.getElementById('dash-cash').innerText = `Rs. ${cashBank.toLocaleString('en-IN')}`;
            document.getElementById('dash-income').innerText = `Rs. ${income.toLocaleString('en-IN')}`;
            document.getElementById('dash-expense').innerText = `Rs. ${expense.toLocaleString('en-IN')}`;
            document.getElementById('dash-overall-expense').innerText = `Rs. ${overallExpense.toLocaleString('en-IN')}`;
            document.getElementById('dash-rec').innerText = `Rs. ${rec.toLocaleString('en-IN')}`;
            document.getElementById('dash-pay').innerText = `Rs. ${pay.toLocaleString('en-IN')}`;
            document.getElementById('dash-stock').innerText = `Rs. ${stockVal.toLocaleString('en-IN')}`;
            document.getElementById('dash-today-sales').innerText = `Rs. ${todaySales.toLocaleString('en-IN')}`;
            document.getElementById('dash-profit').innerText = `Rs. ${netProfit.toLocaleString('en-IN')}`;
            document.getElementById('dash-profit').style.color = netProfit < 0 ? '#dc2626' : '#16a34a';

            const recentTbody = document.getElementById('dash-recent-tx');
            recentTbody.innerHTML = transactions.slice(0, 10).map(tx => `
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:10px;">${formatDate(tx.date)}</td>
                    <td style="padding:10px;">${tx.description}</td>
                    <td style="padding:10px;"><span style="font-size:0.7rem; font-weight:700; padding:2px 8px; border-radius:6px; background:#f1f5f9; color:#475569;">${tx.type}</span></td>
                    <td style="font-weight:700; text-align:right; padding:10px;">Rs. ${getTxAmount(tx).toLocaleString('en-IN')}</td>
                </tr>
            `).join('') || "<tr><td colspan='4' style='text-align:center; padding:20px;'>No recent transactions.</td></tr>";
        }

        // --- Chart Logic ---
        function renderChart() {
            const timeframe = document.getElementById('chart-timeframe').value;
            const ctx = document.getElementById('dashboardChart').getContext('2d');

            if (dashboardChart) dashboardChart.destroy();

            const labels = [];
            const incomeData = [];
            const expenseData = [];

            const now = new Date();

            if (timeframe === 'monthly') {
                const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                months.forEach((m, i) => {
                    labels.push(m);
                    let inc = 0, exp = 0;
                    transactions.forEach(tx => {
                        const d = new Date(tx.date);
                        if (d.getFullYear() === now.getFullYear() && d.getMonth() === i) {
                            tx.entries.forEach(e => {
                                const acc = accounts.find(a => a._id === getAccountId(e.account));
                                if (acc) {
                                    if (acc.type === 'Revenue') inc += (e.credit - e.debit);
                                    if (acc.type === 'Expense') exp += (e.debit - e.credit);
                                }
                            });
                        }
                    });
                    incomeData.push(inc);
                    expenseData.push(exp);
                });
            } else if (timeframe === 'daily') {
                for (let i = 6; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - i);
                    const dateStr = d.toISOString().split('T')[0];
                    labels.push(dateStr);
                    let inc = 0, exp = 0;
                    transactions.forEach(tx => {
                        if (tx.date === dateStr) {
                            tx.entries.forEach(e => {
                                const acc = accounts.find(a => a._id === getAccountId(e.account));
                                if (acc) {
                                    if (acc.type === 'Revenue') inc += (e.credit - e.debit);
                                    if (acc.type === 'Expense') exp += (e.debit - e.credit);
                                }
                            });
                        }
                    });
                    incomeData.push(inc);
                    expenseData.push(exp);
                }
            } else if (timeframe === 'weekly') {
                // Last 4 Weeks
                for (let i = 3; i >= 0; i--) {
                    const d = new Date();
                    d.setDate(d.getDate() - (i * 7));
                    labels.push(`Week -${i}`);

                    let inc = 0, exp = 0;
                    const start = new Date(d);
                    start.setDate(start.getDate() - 6);
                    start.setHours(0,0,0,0);
                    const end = new Date(d);
                    end.setHours(23,59,59,999);

                    transactions.forEach(tx => {
                        const txDate = new Date(tx.date);
                        if (txDate >= start && txDate <= end) {
                            tx.entries.forEach(e => {
                                const acc = accounts.find(a => a._id === getAccountId(e.account));
                                if (acc) {
                                    if (acc.type === 'Revenue') inc += (e.credit - e.debit);
                                    if (acc.type === 'Expense') exp += (e.debit - e.credit);
                                }
                            });
                        }
                    });
                    incomeData.push(inc);
                    expenseData.push(exp);
                }
            } else if (timeframe === 'yearly') {
                for (let i = 4; i >= 0; i--) {
                    const year = now.getFullYear() - i;
                    labels.push(year.toString());
                    let inc = 0, exp = 0;
                    transactions.forEach(tx => {
                        const d = new Date(tx.date);
                        if (d.getFullYear() === year) {
                            tx.entries.forEach(e => {
                                const acc = accounts.find(a => a._id === getAccountId(e.account));
                                if (acc) {
                                    if (acc.type === 'Revenue') inc += (e.credit - e.debit);
                                    if (acc.type === 'Expense') exp += (e.debit - e.credit);
                                }
                            });
                        }
                    });
                    incomeData.push(inc);
                    expenseData.push(exp);
                }
            }

            dashboardChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Income',
                            data: incomeData,
                            backgroundColor: '#10b981',
                            borderRadius: 4
                        },
                        {
                            label: 'Expense',
                            data: expenseData,
                            backgroundColor: '#dc2626',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 6 } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { display: true, color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function renderAccountsList(filtered = null) {
            const tbody = document.getElementById('accounts-list-body');
            const dataToRender = filtered || accounts;

            tbody.innerHTML = dataToRender.map(acc => `
                <tr style="border-bottom:1px solid #f1f5f9;">
                    <td style="padding:15px; cursor:pointer;" onclick="viewStatement('${acc._id}')">
                        <div class="account-name-hover" style="font-weight:600; color:var(--primary-color); text-decoration:none;">${acc.name}</div>
                        <div style="font-size:0.75rem; color:#64748b; margin-top:2px;">PAN: ${acc.panVat || '-'} | ${acc.phone || 'No Phone'}</div>
                    </td>
                    <td style="padding:15px;"><span style="background:#f1f5f9; padding:4px 10px; border-radius:6px; font-size:0.8rem; color:#475569;">${acc.group || acc.type}</span></td>
                    <td style="padding:15px; text-align:right; font-weight:700; color:${acc.balance < 0 ? '#dc2626' : '#16a34a'}">
                        Rs. ${Math.abs(acc.balance || 0).toLocaleString('en-IN', {minimumFractionDigits: 2})}
                        <span style="font-size:0.7rem; color:#64748b;">${acc.balance < 0 ? ' (Dr)' : ' (Cr)'}</span>
                    </td>
                    <td style="padding:15px;">
                        <div style="display:flex; gap:12px; justify-content:center;">
                            <button onclick="viewStatement('${acc._id}')" title="Statement" class="btn-icon" style="color:#6366f1;"><i class="fas fa-file-invoice"></i></button>
                            <button onclick="editAccount('${acc._id}')" title="Edit" class="btn-icon" style="color:#2563eb;"><i class="fas fa-edit"></i></button>
                            <button onclick="deleteAccount('${acc._id}')" title="Delete" class="btn-icon" style="color:#dc2626;"><i class="fas fa-trash"></i></button>

            </div>
        </div>
                    </td>
                </tr>
            `).join('');

            if (dataToRender.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:30px; color:#64748b;">No accounts found matching your search.</td></tr>`;
            }
        }

        function filterAccountsList() {
            const query = document.getElementById('account-search').value.toLowerCase();
            const filtered = accounts.filter(acc =>
                acc.name.toLowerCase().includes(query) ||
                (acc.group && acc.group.toLowerCase().includes(query)) ||
                (acc.type && acc.type.toLowerCase().includes(query)) ||
                (acc.panVat && acc.panVat.includes(query))
            );
            renderAccountsList(filtered);
        }

        let editingAccountId = null;
        function editAccount(id) {
            const acc = accounts.find(a => a._id === id);
            if (!acc) return;
            editingAccountId = id;
            document.getElementById('modal-title').innerText = 'Edit Account';
            document.getElementById('acc-name').value = acc.name;
            document.getElementById('acc-type').value = acc.type;
            document.getElementById('acc-balance').value = acc.openingBalance || 0;
            document.getElementById('acc-pan').value = acc.panVat || '';
            document.getElementById('account-modal').style.display = 'block';
        }

        async function deleteAccount(id) {
            if (!confirm("Are you sure you want to delete this account? It must not have any transactions.")) return;
            const res = await fetch(`${API_URL}/accounts/${id}?userId=${currentUser.uid}`, { method: 'DELETE' });
            const data = await res.json();
            if (res.ok) {
                alert("Account deleted");
                refreshData('accounts');
            } else {
                alert(data.error || "Delete failed");
            }
        }

        // --- Account Modal Logic ---
        function openAccountModal() {
            editingAccountId = null;
            document.getElementById('modal-title').innerText = 'Add New Account';
            document.getElementById('account-modal').style.display = 'block';
            document.getElementById('acc-name').value = '';
            document.getElementById('acc-balance').value = '0';
        }

        function closeAccountModal() {
            document.getElementById('account-modal').style.display = 'none';
        }

